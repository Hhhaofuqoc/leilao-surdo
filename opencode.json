{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "provider": {
    "githubmodels": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Models",
      "options": {
        "baseURL": "https://models.github.ai/inference",
        "apiKey": "{env:GH_MODELS_KEY}"
      },
      "models": {
        "openai/gpt-4o-mini": { "name": "GPT-4o mini" },
        "openai/gpt-5-mini": { "name": "GPT-5 mini" }
      }
    }
  }
}
